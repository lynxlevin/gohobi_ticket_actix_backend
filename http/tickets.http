# Turn on debug to use these.

###
# @name login
POST {{endpoint}}/api/users/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###
# @name list_user_relations
GET {{endpoint}}/api/user_relations/

@user_relation_id=1

###
# @name list_giving_tickets
GET {{endpoint}}/api/tickets/?user_relation_id={{user_relation_id}}&is_giving

###
# @name list_receiving_tickets
GET {{endpoint}}/api/tickets/?user_relation_id={{user_relation_id}}&is_receiving
